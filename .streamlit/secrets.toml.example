# Copy this file to .streamlit/secrets.toml for local development.
# In Community Cloud, paste the same values into the app's Secrets settings.
presenter_password = "replace-with-a-long-random-password"

# Optional. Leave this out to build QR links from the URL currently in the browser.
# app_base_url = "https://your-app-name.streamlit.app/"

# Optional local override. The default is .qa_data/questions.sqlite3.
# database_path = ".qa_data/questions.sqlite3"
